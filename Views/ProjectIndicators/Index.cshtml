@model IEnumerable<MAAN.SiteOps.Models.ProjectIndicator>
@{ ViewData["Title"] = "Project Indicators"; var project = ViewBag.Project as MAAN.SiteOps.Models.Project; }
<div class="page-header"><div><h2 class="page-title">Project Indicators</h2><p class="page-subtitle">@project?.ProjectCode · @project?.ProjectName</p></div><a asp-action="Create" asp-route-projectId="@project?.Id" class="btn btn-primary">Add Project Indicator</a></div><div class="table-shell table-responsive"><table class="table"><thead><tr><th>Code</th><th>Global Code</th><th>Indicator</th><th>Unit</th><th>Target</th><th>Achievement</th><th>Active</th><th>Actions</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.ProjectIndicatorCode</td><td>@item.Indicator?.GlobalCode</td><td>@item.Indicator?.Name</td><td>@item.Indicator?.UnitType</td><td>@item.TargetValue</td><td>Not calculated</td><td>@item.IsActive</td><td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a> <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>@if (item.IsActive) { <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger">Deactivate</button></form> }</td></tr> }</tbody></table></div>
