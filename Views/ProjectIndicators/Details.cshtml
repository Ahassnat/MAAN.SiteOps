@model MAAN.SiteOps.Models.ProjectIndicator
@{ ViewData["Title"] = "Project Indicator Details"; }
<div class="page-header"><div><h2 class="page-title">@Model.ProjectIndicatorCode</h2><p class="page-subtitle">@Model.Indicator?.Name</p></div></div><section class="section-card"><dl class="row mb-0"><dt class="col-sm-3">Global Code</dt><dd class="col-sm-9">@Model.Indicator?.GlobalCode</dd><dt class="col-sm-3">Unit</dt><dd class="col-sm-9">@Model.Indicator?.UnitType</dd><dt class="col-sm-3">Target</dt><dd class="col-sm-9">@Model.TargetValue</dd><dt class="col-sm-3">Men / Women</dt><dd class="col-sm-9">@Model.TargetMen / @Model.TargetWomen</dd><dt class="col-sm-3">Boys / Girls</dt><dd class="col-sm-9">@Model.TargetBoys / @Model.TargetGirls</dd><dt class="col-sm-3">Achievement</dt><dd class="col-sm-9">Not calculated</dd><dt class="col-sm-3">Means of Verification</dt><dd class="col-sm-9">@Model.MeansOfVerification</dd><dt class="col-sm-3">Notes</dt><dd class="col-sm-9">@Model.Notes</dd></dl></section><div class="form-actions"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a><a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-outline-secondary">Back</a></div>
