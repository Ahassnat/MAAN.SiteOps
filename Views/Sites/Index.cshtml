@model IEnumerable<MAAN.SiteOps.Models.Site>
@{
    ViewData["Title"] = "Sites";
}
<div class="page-header"><div><h2 class="page-title">Sites</h2><p class="page-subtitle">Maintain the shared site registry used across projects.</p></div><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Add Site</a></div>
<div class="table-shell table-responsive"><table class="table"><thead><tr><th>Site Code</th><th>Site Name</th><th>Governorate</th><th>Area</th><th>Active</th><th>Managed by MA'AN</th><th>Actions</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td><strong>@item.SiteCode</strong></td><td>@item.SiteName</td><td>@item.Governorate?.Name</td><td>@item.Area</td><td>@if (item.IsActive) { <span class="badge status-approved">Active</span> } else { <span class="badge status-draft">Inactive</span> }</td><td>@if (item.IsManagedByMaan) { <span class="badge status-approved">Yes</span> } else { <span class="badge status-draft">No</span> }</td><td class="text-nowrap"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a> <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a> <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a></td></tr> }
</tbody></table></div>
