@model IEnumerable<MAAN.SiteOps.Models.ReportDefinition>
@{ ViewData["Title"] = "Report Definitions"; }
<div class="page-header"><div><h2 class="page-title">Report Definitions</h2><p class="page-subtitle">Configure reusable reporting structures.</p></div><a asp-action="Create" class="btn btn-primary">Add Report Definition</a></div><div class="table-shell table-responsive"><table class="table"><thead><tr><th>Code</th><th>Name</th><th>Frequency</th><th>Active</th><th>Actions</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Code</td><td>@item.Name</td><td>@item.Frequency</td><td>@item.IsActive</td><td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a> <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a></td></tr> }</tbody></table></div>
