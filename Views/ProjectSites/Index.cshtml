@model IEnumerable<MAAN.SiteOps.Models.ProjectSite>

@{
    ViewData["Title"] = "Index";
}

<h1>Project Sites</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
   <thead>
    <tr>
        <th>Project</th>
        <th>Site</th>
        <th>Support Start</th>
        <th>Support End</th>
        <th>Site Cohort</th>
        <th>Active</th>
        <th>Notes</th>
        <th></th>
    </tr>
</thead>
   <tbody>
@foreach (var item in Model)
{
    <tr>
        <td>
            @($"{item.Project?.ProjectCode} - {item.Project?.ProjectName}")
        </td>
        <td>
            @($"{item.Site?.SiteCode} - {item.Site?.SiteName}")
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.SupportStartDate)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.SupportEndDate)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.SiteCohort)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.IsActive)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Notes)
        </td>
        <td>
            <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
            <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
            <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
        </td>
    </tr>
}
</tbody>
</table>
