@model IEnumerable<MAAN.SiteOps.Models.ActivityType>
@{ ViewData["Title"] = "Activity Types"; }
<div class="page-header"><div><h2 class="page-title">Activity Types</h2><p class="page-subtitle">Configure activity reporting behavior without code changes.</p></div><a asp-action="Create" class="btn btn-primary">Add Activity Type</a></div><div class="table-shell table-responsive"><table class="table"><thead><tr><th>Name</th><th>Category</th><th>Active</th><th>Participants</th><th>Attachment</th><th>Summary</th><th>Actions</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Name</td><td>@item.ActivityCategory?.Name</td><td>@item.IsActive</td><td>@item.RequiresParticipants</td><td>@item.RequiresAttachment</td><td>@item.RequiresSummary</td><td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a></td></tr> }</tbody></table></div>
