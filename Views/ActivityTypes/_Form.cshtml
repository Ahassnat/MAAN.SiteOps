@model MAAN.SiteOps.Models.ActivityType
<div class="row g-3"><div class="col-md-8"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div><div class="col-md-4"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" /></div><div class="col-12"><label asp-for="ActivityCategoryId" class="form-label">Category</label><select asp-for="ActivityCategoryId" class="form-select" asp-items="ViewBag.ActivityCategoryId"></select></div><div class="col-md-3"><label asp-for="DisplayOrder" class="form-label"></label><input asp-for="DisplayOrder" class="form-control" /></div>@foreach (var flag in new[] { "RequiresParticipants", "RequiresPWD", "RequiresTopic", "AllowsMultipleTopics", "RequiresItems", "RequiresAttachment", "RequiresSummary", "IsActive" }) { <div class="col-md-3 form-check ms-2"><input name="@flag" type="checkbox" class="form-check-input" checked="@(Model.GetType().GetProperty(flag)?.GetValue(Model) is true)" /><label class="form-check-label">@flag</label></div> }</div>
