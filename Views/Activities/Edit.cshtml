@model MAAN.SiteOps.ViewModels.ActivityFormViewModel
@{
    ViewData["Title"] = "Edit Activity";
}

<div class="page-header"><div><h2 class="page-title">Edit Activity</h2><p class="page-subtitle">Update this draft or returned activity report.</p></div></div>
<div class="row"><div class="col-xl-9">
        <form asp-action="Edit" method="post">
            <partial name="_Form" model="Model" />
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}