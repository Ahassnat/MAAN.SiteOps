@model MAAN.SiteOps.Models.Activity
@{
    ViewData["Title"] = "Activity Details";
    var canEdit = Model.Status is MAAN.SiteOps.Models.Activity.DraftStatus or MAAN.SiteOps.Models.Activity.ReturnedStatus;
}

<div class="page-header"><div><h2 class="page-title">@Model.ActivityType?.Name</h2><p class="page-subtitle">@Model.Site?.SiteCode - @Model.Site?.SiteName</p></div><span class="badge @(Model.Status == "Approved" ? "status-approved" : Model.Status == "Returned" ? "status-returned" : Model.Status == "Submitted" ? "status-submitted" : Model.Status == "Cancelled" ? "status-cancelled" : "status-draft")">@Model.Status</span></div>
@if (TempData["ActivityWarning"] is string warning)
{
    <div class="alert alert-warning">@warning</div>
}
<section class="section-card"><h3 class="section-heading">Activity Information</h3><dl class="row mb-0">
    <dt class="col-sm-3">Project</dt><dd class="col-sm-9">@(Model.ProjectSite?.Project is null ? "Unassigned" : $"{Model.ProjectSite.Project.ProjectCode} - {Model.ProjectSite.Project.ProjectName}")</dd>
    <dt class="col-sm-3">Site</dt><dd class="col-sm-9">@Model.Site?.SiteCode - @Model.Site?.SiteName</dd>
    <dt class="col-sm-3">Activity Date</dt><dd class="col-sm-9">@Model.ActivityDate.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-3">Category</dt><dd class="col-sm-9">@Model.ActivityType?.ActivityCategory?.Name</dd>
    <dt class="col-sm-3">Activity Type</dt><dd class="col-sm-9">@Model.ActivityType?.Name</dd>
    <dt class="col-sm-3">Implementation Role</dt><dd class="col-sm-9">@Model.ImplementationRole</dd>
</dl></section>

<section class="section-card"><h3 class="section-heading">Project Attribution</h3>
<div class="table-responsive"><table class="table"><thead><tr><th>Project</th><th>Site</th><th>Role</th><th>Primary</th><th></th></tr></thead><tbody>
@foreach (var attribution in Model.ProjectAttributions.OrderByDescending(a => a.IsPrimary)) { <tr><td>@attribution.ProjectSite?.Project?.ProjectCode</td><td>@attribution.ProjectSite?.Site?.SiteCode - @attribution.ProjectSite?.Site?.SiteName</td><td>@attribution.AttributionRole</td><td>@(attribution.IsPrimary ? "Yes" : "No")</td><td>@if (!attribution.IsPrimary) { <form asp-action="RemoveAttribution" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="attributionId" value="@attribution.Id" /><button class="btn btn-sm btn-outline-danger">Remove</button></form> }</td></tr> }
</tbody></table></div>
@if (ViewBag.AdditionalProjectSites is IEnumerable<MAAN.SiteOps.Models.ProjectSite> options && options.Any()) { <form asp-action="AddAttribution" method="post" class="row g-2 align-items-end"><input type="hidden" name="id" value="@Model.Id" /><div class="col-md-5"><label class="form-label">Additional Project</label><select name="projectSiteId" class="form-select">@foreach (var option in options) { <option value="@option.Id">@option.Project?.ProjectCode - @option.Site?.SiteCode</option> }</select></div><div class="col-md-3"><label class="form-label">Role</label><input name="role" class="form-control" /></div><div class="col-md-3"><label class="form-label">Notes</label><input name="notes" class="form-control" /></div><div class="col-md-1"><button class="btn btn-primary">Add</button></div></form> }
</section>

<section class="section-card"><h3 class="section-heading">Participants</h3><dl class="row mb-0">
    <dt class="col-sm-3">Men</dt><dd class="col-sm-9">@(Model.Participant?.Men ?? 0)</dd>
    <dt class="col-sm-3">Women</dt><dd class="col-sm-9">@(Model.Participant?.Women ?? 0)</dd>
    <dt class="col-sm-3">Boys</dt><dd class="col-sm-9">@(Model.Participant?.Boys ?? 0)</dd>
    <dt class="col-sm-3">Girls</dt><dd class="col-sm-9">@(Model.Participant?.Girls ?? 0)</dd>
    <dt class="col-sm-3">Elderly Men</dt><dd class="col-sm-9">@(Model.Participant?.ElderlyMen ?? 0)</dd>
    <dt class="col-sm-3">Elderly Women</dt><dd class="col-sm-9">@(Model.Participant?.ElderlyWomen ?? 0)</dd>
    <dt class="col-sm-3">Persons with Disabilities</dt><dd class="col-sm-9">@(Model.Participant?.PersonsWithDisabilities ?? 0)</dd>
    <dt class="col-sm-3">Total Participants</dt><dd class="col-sm-9">@(Model.Participant?.TotalParticipants ?? 0)</dd>
</dl></section>

<section class="section-card"><h3 class="section-heading">Reporting Details</h3><dl class="row mb-0"><dt class="col-sm-3">Summary</dt><dd class="col-sm-9">@Model.Summary</dd><dt class="col-sm-3">Notes</dt><dd class="col-sm-9">@Model.Notes</dd></dl></section>

<section class="section-card"><h3 class="section-heading">Workflow Information</h3><dl class="row mb-0"><dt class="col-sm-3">Created At</dt><dd class="col-sm-9">@Model.CreatedAt.ToLocalTime()</dd><dt class="col-sm-3">Submitted At</dt><dd class="col-sm-9">@Model.SubmittedAt?.ToLocalTime()</dd><dt class="col-sm-3">Reviewed At</dt><dd class="col-sm-9">@Model.ReviewedAt?.ToLocalTime()</dd><dt class="col-sm-3">Review Notes</dt><dd class="col-sm-9">@Model.ReviewNotes</dd></dl></section>

<section class="section-card"><h3 class="section-heading">Status History</h3><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Changed At</th><th>From</th><th>To</th><th>Comment</th></tr></thead><tbody>@foreach (var history in Model.StatusHistory.OrderByDescending(h => h.ChangedAt)) { <tr><td>@history.ChangedAt.ToLocalTime()</td><td>@history.OldStatus</td><td>@history.NewStatus</td><td>@history.Comment</td></tr> }</tbody></table></div></section>

<div class="workflow-actions mt-4">
    @if (canEdit) { <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a><form asp-action="Submit" asp-route-id="@Model.Id" method="post"><button class="btn btn-warning" type="submit">Submit</button></form> }
    @if (Model.Status == MAAN.SiteOps.Models.Activity.DraftStatus) { <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a> }
    @if (Model.Status == MAAN.SiteOps.Models.Activity.SubmittedStatus) { <form asp-action="Approve" asp-route-id="@Model.Id" method="post"><button class="btn btn-success" type="submit">Approve</button></form> }
    @if (Model.Status == MAAN.SiteOps.Models.Activity.SubmittedStatus) { <form asp-action="Return" asp-route-id="@Model.Id" method="post" class="d-flex gap-2"><input name="comment" class="form-control" placeholder="Return reason (optional)" /><button class="btn btn-danger" type="submit">Return</button></form> }
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Activities</a>
</div>