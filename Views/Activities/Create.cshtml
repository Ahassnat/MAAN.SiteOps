@model MAAN.SiteOps.ViewModels.ActivityFormViewModel
@{
    ViewData["Title"] = "Create Activity";
}

<div class="page-header"><div><h2 class="page-title">Create Activity</h2><p class="page-subtitle">Capture a site-level activity report.</p></div></div>
<div class="row"><div class="col-xl-9">
        <form asp-action="Create" method="post">
            <partial name="_Form" model="Model" />
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Create Activity</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}