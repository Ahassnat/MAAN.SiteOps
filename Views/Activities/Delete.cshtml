@model MAAN.SiteOps.Models.Activity
@{
    ViewData["Title"] = "Delete Activity";
}
<h1>Delete Activity</h1>
<div class="alert alert-warning">Are you sure you want to delete this Draft activity?</div>
<dl class="row"><dt class="col-sm-3">Project</dt><dd class="col-sm-9">@(Model.ProjectSite?.Project?.ProjectCode ?? "Unassigned")</dd><dt class="col-sm-3">Site</dt><dd class="col-sm-9">@Model.Site?.SiteCode - @Model.Site?.SiteName</dd><dt class="col-sm-3">Activity Type</dt><dd class="col-sm-9">@Model.ActivityType?.Name</dd><dt class="col-sm-3">Activity Date</dt><dd class="col-sm-9">@Model.ActivityDate.ToString("yyyy-MM-dd")</dd></dl>
<form asp-action="Delete" method="post"><input type="hidden" asp-for="Id" /><button type="submit" class="btn btn-danger">Delete</button> <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a></form>