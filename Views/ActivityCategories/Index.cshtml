@model IEnumerable<MAAN.SiteOps.Models.ActivityCategory>
@{ ViewData["Title"] = "Activity Categories"; }
<div class="page-header"><div><h2 class="page-title">Activity Categories</h2><p class="page-subtitle">Manage the configurable activity taxonomy.</p></div><a asp-action="Create" class="btn btn-primary">Add Category</a></div><div class="table-shell table-responsive"><table class="table"><thead><tr><th>Code</th><th>Name</th><th>Order</th><th>Activity Types</th><th>Active</th><th>Actions</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Code</td><td>@item.Name</td><td>@item.DisplayOrder</td><td>@item.ActivityTypes.Count</td><td>@item.IsActive</td><td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a></td></tr> }</tbody></table></div>
