@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    bool IsActive(string name, string? actionName = null) =>
        string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) &&
        (actionName is null || string.Equals(action, actionName, StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MA'AN SiteOps</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MAAN.SiteOps.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="appSidebar" aria-labelledby="sidebarLabel">
            <div class="sidebar-brand">
                <div class="brand-mark">M</div>
                <div><div id="sidebarLabel" class="brand-name">MA'AN SiteOps</div><div class="brand-subtitle">Site management operations</div></div>
                <button type="button" class="btn-close btn-close-white d-lg-none ms-auto" data-bs-dismiss="offcanvas" aria-label="Close navigation"></button>
            </div>
            <nav class="sidebar-nav" aria-label="Primary navigation">
                <div class="nav-section-label">Workspace</div>
                <a class="sidebar-link @(IsActive("Home") ? "active" : "")" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span></a>
                <a class="sidebar-link @(IsActive("Activities") ? "active" : "")" asp-controller="Activities" asp-action="Index"><i class="bi bi-clipboard2-check-fill"></i><span>Activities</span></a>
                <a class="sidebar-link @(IsActive("Projects") ? "active" : "")" asp-controller="Projects" asp-action="Index"><i class="bi bi-folder2-open"></i><span>Projects</span></a>
                <a class="sidebar-link @(IsActive("Sites") ? "active" : "")" asp-controller="Sites" asp-action="Index"><i class="bi bi-geo-alt-fill"></i><span>Sites</span></a>
                <a class="sidebar-link @(IsActive("ProjectSites") ? "active" : "")" asp-controller="ProjectSites" asp-action="Index"><i class="bi bi-diagram-3-fill"></i><span>Project Sites</span></a>
                <a class="sidebar-link @(IsActive("Imports") ? "active" : "")" asp-controller="Imports" asp-action="Index"><i class="bi bi-cloud-arrow-up"></i><span>Data Imports</span></a>
                <div class="nav-section-label mt-4">Configuration</div>
                <a class="sidebar-link @(IsActive("Indicators") ? "active" : "")" asp-controller="Indicators" asp-action="Index"><i class="bi bi-bar-chart-line"></i><span>Indicators</span></a>
                <a class="sidebar-link @(IsActive("ActivityTypes") ? "active" : "")" asp-controller="ActivityTypes" asp-action="Index"><i class="bi bi-ui-checks-grid"></i><span>Activity Types</span></a>
                <a class="sidebar-link @(IsActive("ActivityCategories") ? "active" : "")" asp-controller="ActivityCategories" asp-action="Index"><i class="bi bi-tags"></i><span>Activity Categories</span></a>
                <a class="sidebar-link @(IsActive("ReportDefinitions") ? "active" : "")" asp-controller="ReportDefinitions" asp-action="Index"><i class="bi bi-file-earmark-bar-graph"></i><span>Report Definitions</span></a>
            </nav>
            <div class="sidebar-footer">MA'AN humanitarian operations</div>
        </aside>
        <div class="app-content">
            <header class="topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="sidebar-toggle d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-label="Open navigation"><i class="bi bi-list"></i></button>
                    <div><div class="topbar-kicker">MA'AN SiteOps</div><h1 class="topbar-title">@ViewData["Title"]</h1></div>
                </div>
                <div class="topbar-context"><i class="bi bi-shield-check"></i><span>Operations workspace</span></div>
            </header>
            <main class="main-content" role="main">@RenderBody()</main>
            <footer class="app-footer">MA'AN SiteOps <span>·</span> Site Management Operations &amp; Reporting</footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
