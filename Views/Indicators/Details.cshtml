@model MAAN.SiteOps.Models.Indicator
@{ ViewData["Title"] = "Indicator Details"; }
<div class="page-header"><div><h2 class="page-title">@Model.Name</h2><p class="page-subtitle">Indicator configuration</p></div></div><section class="section-card"><dl class="row mb-0"><dt class="col-sm-3">Global Code</dt><dd class="col-sm-9">@Model.GlobalCode</dd><dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Description</dd><dt class="col-sm-3">Unit</dt><dd class="col-sm-9">@Model.UnitType</dd><dt class="col-sm-3">Calculation</dt><dd class="col-sm-9">@Model.CalculationMode</dd><dt class="col-sm-3">Data Source</dt><dd class="col-sm-9">@Model.DataSourceType</dd><dt class="col-sm-3">Active</dt><dd class="col-sm-9">@Model.IsActive</dd></dl></section><div class="form-actions"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a><a asp-action="Index" class="btn btn-outline-secondary">Back</a></div>
