@model IEnumerable<MAAN.SiteOps.Models.Indicator>
@{ ViewData["Title"] = "Indicators"; }
<div class="page-header"><div><h2 class="page-title">Indicators</h2><p class="page-subtitle">Manage reusable indicator definitions.</p></div><a asp-action="Create" class="btn btn-primary">Add Indicator</a></div>
<div class="table-shell table-responsive"><table class="table"><thead><tr><th>Global Code</th><th>Indicator Name</th><th>Unit</th><th>Calculation Mode</th><th>Data Source</th><th>Active</th><th>Actions</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.GlobalCode</td><td>@item.Name</td><td>@item.UnitType</td><td>@item.CalculationMode</td><td>@item.DataSourceType</td><td>@(item.IsActive ? "Yes" : "No")</td><td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a> <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>@if (item.IsActive) { <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger">Deactivate</button></form> }</td></tr> }</tbody></table></div>
