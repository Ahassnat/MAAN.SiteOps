@model MAAN.SiteOps.Models.ProjectReport
@{ ViewData["Title"] = "Report Indicator Mappings"; var indicators = ViewBag.Indicators as IEnumerable<MAAN.SiteOps.Models.ProjectIndicator> ?? []; }
<div class="page-header"><div><h2 class="page-title">Report Indicator Mappings</h2><p class="page-subtitle">@Model.Project?.ProjectCode · @Model.ReportDefinition?.Name</p></div></div>
@if (TempData["MappingError"] is string mappingError) { <div class="alert alert-danger">@mappingError</div> }
<section class="section-card"><h3 class="section-heading">Current Mappings</h3><div class="table-responsive"><table class="table"><thead><tr><th>Indicator</th><th>Field Code</th><th>Field Name</th><th>Order</th><th></th></tr></thead><tbody>@foreach (var item in Model.ReportIndicatorMappings) { <tr><td>@item.ProjectIndicator?.ProjectIndicatorCode</td><td>@item.ReportFieldCode</td><td>@item.ReportFieldName</td><td>@item.DisplayOrder</td><td><form asp-action="RemoveMapping" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-danger">Remove</button></form></td></tr> }</tbody></table></div></section><section class="section-card"><h3 class="section-heading">Add Mapping</h3><form asp-action="AddMapping" method="post"><input type="hidden" name="id" value="@Model.Id" /><div class="row g-3"><div class="col-md-4"><label class="form-label">Project Indicator</label><select name="projectIndicatorId" class="form-select">@foreach (var item in indicators) { <option value="@item.Id">@item.ProjectIndicatorCode - @item.Indicator?.Name</option> }</select></div><div class="col-md-2"><label class="form-label">Field Code</label><input name="reportFieldCode" class="form-control" required /></div><div class="col-md-3"><label class="form-label">Field Name</label><input name="reportFieldName" class="form-control" required /></div><div class="col-md-1"><label class="form-label">Order</label><input name="displayOrder" type="number" value="1" class="form-control" /></div><div class="col-md-2"><label class="form-label">Notes</label><input name="notes" class="form-control" /></div></div><div class="form-actions"><button class="btn btn-primary">Add Mapping</button><a asp-action="Index" asp-route-projectId="@Model.Project?.Id" class="btn btn-outline-secondary">Back</a></div></form></section>
