@model IEnumerable<MAAN.SiteOps.Models.ProjectReport>
@{ ViewData["Title"] = "Project Reports"; var project = ViewBag.Project as MAAN.SiteOps.Models.Project; }
<div class="page-header"><div><h2 class="page-title">Project Reports</h2><p class="page-subtitle">@project?.ProjectCode · @project?.ProjectName</p></div><a asp-action="Create" asp-route-projectId="@project?.Id" class="btn btn-primary">Link Report</a></div><div class="table-shell table-responsive"><table class="table"><thead><tr><th>Report</th><th>Frequency</th><th>Start</th><th>End</th><th>Active</th><th>Actions</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.ReportDefinition?.Name</td><td>@item.ReportDefinition?.Frequency</td><td>@item.StartDate?.ToString("yyyy-MM-dd")</td><td>@item.EndDate?.ToString("yyyy-MM-dd")</td><td>@item.IsActive</td><td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a> <a asp-action="Mappings" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Mappings</a></td></tr> }</tbody></table></div>
