@model MAAN.SiteOps.Models.ProjectReport
@{ ViewData["Title"] = "Edit Project Report"; }
<div class="page-header"><div><h2 class="page-title">Edit Project Report</h2></div></div><form asp-action="Edit"><input type="hidden" asp-for="Id" /><input type="hidden" asp-for="ProjectId" /><div class="row g-3"><div class="col-md-8"><label asp-for="ReportDefinitionId" class="form-label">Report Definition</label><select asp-for="ReportDefinitionId" class="form-select" asp-items="ViewBag.ReportDefinitionId"></select></div><div class="col-md-4"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" class="form-control" /></div><div class="col-md-4"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" class="form-control" /></div><div class="col-md-8"><label asp-for="Notes" class="form-label"></label><input asp-for="Notes" class="form-control" /></div><div class="col-12 form-check ms-2"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div><div class="form-actions"><button class="btn btn-primary">Save Changes</button><a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-outline-secondary">Cancel</a></div></form>
