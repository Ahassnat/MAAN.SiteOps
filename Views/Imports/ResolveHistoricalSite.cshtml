@model MAAN.SiteOps.ViewModels.HistoricalSiteResolutionViewModel
@{ ViewData["Title"] = "Resolve Historical Site"; }
<div class="page-header"><div><h2 class="page-title">Resolve Historical Site</h2><p class="page-subtitle">Review the source reference and explicitly confirm Site details.</p></div></div>
<div class="alert alert-warning">This creates a historical Site record only. It does not assign the Site to any Project.</div>
<section class="section-card mb-4"><h3 class="section-heading">Source Activity Records</h3><dl class="row mb-0"><dt class="col-sm-3">Source Site Code</dt><dd class="col-sm-9">@Model.SiteCode</dd><dt class="col-sm-3">Source Site Name</dt><dd class="col-sm-9">@Model.SiteName</dd><dt class="col-sm-3">Activity Record Count</dt><dd class="col-sm-9">@Model.ActivityRecordCount</dd><dt class="col-sm-3">Earliest Activity Date</dt><dd class="col-sm-9">@Model.EarliestActivityDate?.ToString("yyyy-MM-dd")</dd><dt class="col-sm-3">Latest Activity Date</dt><dd class="col-sm-9">@Model.LatestActivityDate?.ToString("yyyy-MM-dd")</dd></dl></section>
<form asp-action="CreateHistoricalSite" method="post" class="section-card"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input type="hidden" asp-for="ActivityRecordCount" /><input type="hidden" asp-for="EarliestActivityDate" /><input type="hidden" asp-for="LatestActivityDate" /><div class="row g-3"><div class="col-md-4"><label asp-for="SiteCode" class="form-label"></label><input asp-for="SiteCode" class="form-control" /><span asp-validation-for="SiteCode" class="text-danger"></span></div><div class="col-md-8"><label asp-for="SiteName" class="form-label"></label><input asp-for="SiteName" class="form-control" /><span asp-validation-for="SiteName" class="text-danger"></span></div><div class="col-md-6"><label asp-for="GovernorateId" class="form-label">Governorate</label><select asp-for="GovernorateId" asp-items="ViewBag.GovernorateId" class="form-select"><option value="">-- Select existing Governorate --</option></select><span asp-validation-for="GovernorateId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Area" class="form-label"></label><input asp-for="Area" class="form-control" /></div><div class="col-md-6"><label asp-for="Latitude" class="form-label"></label><input asp-for="Latitude" class="form-control" /></div><div class="col-md-6"><label asp-for="Longitude" class="form-label"></label><input asp-for="Longitude" class="form-control" /></div><div class="col-12 form-check ms-2"><input class="form-check-input" type="checkbox" checked disabled /><label class="form-check-label">Historical / Inactive (new Site will be created inactive)</label></div></div><div class="form-actions"><button class="btn btn-primary" type="submit">Create Historical Site</button><a href="javascript:history.back()" class="btn btn-outline-secondary">Cancel</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
