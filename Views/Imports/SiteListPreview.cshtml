@model MAAN.SiteOps.ViewModels.SiteListPreviewViewModel
@{ ViewData["Title"] = "ZITE Site List Preview"; string Badge(string status) => status switch { "New" => "status-approved", "Existing" => "status-draft", "Existing With Changes" => "status-submitted", "Warning" => "status-submitted", _ => "status-returned" }; }
<div class="page-header"><div><h2 class="page-title">ZITE Site List Preview</h2><p class="page-subtitle">@Model.FileName · Review records before updating the Site master.</p></div><a asp-action="Index" class="btn btn-outline-secondary">Back to Imports</a></div>
@if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="alert alert-danger">@Model.Error</div> } else {
<div class="kpi-grid"><div class="dashboard-card kpi-card"><div class="kpi-label">Sites Read</div><div class="kpi-value">@Model.SitesRead</div></div><div class="dashboard-card kpi-card"><div class="kpi-label">New Sites</div><div class="kpi-value">@Model.NewSites</div></div><div class="dashboard-card kpi-card"><div class="kpi-label">Existing Sites</div><div class="kpi-value">@Model.ExistingSites</div></div><div class="dashboard-card kpi-card"><div class="kpi-label">Sites With Changes</div><div class="kpi-value">@Model.SitesWithChanges</div></div><div class="dashboard-card kpi-card"><div class="kpi-label">Unresolved Governorates</div><div class="kpi-value">@Model.UnresolvedGovernorates</div></div><div class="dashboard-card kpi-card"><div class="kpi-label">Errors</div><div class="kpi-value">@Model.Errors</div></div></div>
<div class="table-shell table-responsive"><table class="table"><thead><tr><th>Source Site Code</th><th>Source Site Name</th><th>Matched Site</th><th>Governorate</th><th>Area</th><th>Status</th><th>Warnings</th></tr></thead><tbody>@foreach (var site in Model.Records) { <tr><td>@site.SourceSiteCode</td><td>@site.SourceSiteName</td><td>@(site.ExistingSiteId.HasValue ? $"Site #{site.ExistingSiteId}" : "New site")</td><td>@(site.MatchedGovernorateName ?? site.SourceGovernorate)</td><td>@site.SourceArea</td><td><span class="badge @Badge(site.Status)">@site.Status</span></td><td>@string.Join(" ", site.Warnings)</td></tr> }</tbody></table></div>
@if (Model.NewSites + Model.SitesWithChanges > 0) { <form asp-action="ImportSiteList" method="post" class="form-actions"><input type="hidden" name="previewToken" value="@Model.PreviewToken" /><button class="btn btn-primary">Import Sites</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form> }
}
