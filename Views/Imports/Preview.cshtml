@model MAAN.SiteOps.ViewModels.ImportPreviewViewModel
@{ ViewData["Title"] = "Import Preview"; string Badge(string status) => status switch { "Ready" => "status-approved", "Warning" => "status-submitted", "Duplicate" => "status-returned", _ => "status-draft" }; }
<div class="page-header"><div><h2 class="page-title">Import Preview</h2><p class="page-subtitle">@Model.FileName · @Model.DetectedSheet</p></div><a asp-action="Index" class="btn btn-outline-secondary">Back to Imports</a></div>
@if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="alert alert-danger">@Model.Error</div> } else { <div class="kpi-grid"><div class="dashboard-card kpi-card"><div class="kpi-label">Records Read</div><div class="kpi-value">@Model.RecordsRead</div></div><div class="dashboard-card kpi-card"><div class="kpi-label">Ready for Import</div><div class="kpi-value">@Model.ReadyForImport</div></div><div class="dashboard-card kpi-card"><div class="kpi-label">Unresolved Sites</div><div class="kpi-value">@Model.UnresolvedSites</div></div><div class="dashboard-card kpi-card"><div class="kpi-label">Unresolved Types</div><div class="kpi-value">@Model.UnresolvedActivityTypes</div></div><div class="dashboard-card kpi-card"><div class="kpi-label">Possible Duplicates</div><div class="kpi-value">@Model.PossibleDuplicates</div></div><div class="dashboard-card kpi-card"><div class="kpi-label">Already Imported</div><div class="kpi-value">@Model.AlreadyImported</div></div></div><div class="filter-card d-flex gap-2"><button class="btn btn-sm btn-primary preview-filter" data-filter="All">All</button><button class="btn btn-sm btn-outline-secondary preview-filter" data-filter="Ready">Ready</button><button class="btn btn-sm btn-outline-secondary preview-filter" data-filter="Warning">Warnings</button><button class="btn btn-sm btn-outline-secondary preview-filter" data-filter="Unresolved">Unresolved</button><button class="btn btn-sm btn-outline-secondary preview-filter" data-filter="Duplicate">Duplicates</button></div><div class="table-shell table-responsive"><table class="table" id="previewTable"><thead><tr><th>Row</th><th>Date</th><th>Source Site</th><th>Matched Site</th><th>Source Activity Type</th><th>Matched Activity Type</th><th>Participants</th><th>Source Donor</th><th>Status</th><th>Warnings</th></tr></thead><tbody>@foreach (var item in Model.Records) { <tr data-status="@item.Status"><td>@item.RowNumber</td><td>@item.ActivityDate?.ToString("yyyy-MM-dd")</td><td>@item.SourceSiteCode<br /><small>@item.SourceSiteName</small></td><td>@item.MatchedSiteDisplay</td><td>@item.SourceActivityType</td><td>@item.MatchedActivityTypeName</td><td>@item.ParticipantsTotal</td><td>@item.SourceDonorLabel</td><td><span class="badge @Badge(item.Status)">@item.Status</span></td><td>@string.Join(" ", item.Warnings)</td></tr> }</tbody></table></div> }</div>
@section Scripts { <script>document.querySelectorAll('.preview-filter').forEach(button => button.addEventListener('click', () => { const filter = button.dataset.filter; document.querySelectorAll('#previewTable tbody tr').forEach(row => row.style.display = filter === 'All' || row.dataset.status === filter ? '' : 'none'); }));</script> }
