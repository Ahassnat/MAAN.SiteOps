@model IEnumerable<MAAN.SiteOps.Models.ImportBatch>
@{ ViewData["Title"] = "Data Imports"; }
<div class="page-header"><div><h2 class="page-title">Data Imports</h2><p class="page-subtitle">Preview source workbooks before any operational data is created.</p></div></div>
@if (TempData["ImportError"] is string error) { <div class="alert alert-danger">@error</div> }
<section class="section-card mb-4"><h3 class="section-heading">Preview ZITE Activity Report</h3><form asp-action="Preview" method="post" enctype="multipart/form-data" class="row g-3 align-items-end"><div class="col-md-3"><label class="form-label">Source System</label><select name="sourceSystemCode" class="form-select" asp-items="ViewBag.SourceSystems"></select></div><div class="col-md-6"><label class="form-label" for="file">Excel workbook</label><input class="form-control" type="file" name="file" id="file" accept=".xlsx,.xls" required /></div><div class="col-md-3"><button class="btn btn-primary w-100"><i class="bi bi-search me-1"></i> Preview Import</button></div></form><p class="text-muted small mt-3 mb-0">Dry run only. Activities, sites, project assignments, source records, and indicators will not be created.</p></section>
<section class="section-card"><div class="d-flex justify-content-between align-items-center mb-2"><h3 class="section-heading mb-0">Import History</h3></div><div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Source</th><th>File</th><th>Status</th><th>Total Records</th><th>Ready / Linked</th><th>Warnings / Errors</th><th>Action</th></tr></thead><tbody>@foreach (var batch in Model) { <tr><td>@batch.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td>@batch.SourceSystem?.Code</td><td>@batch.FileName</td><td><span class="badge status-submitted">@batch.Status</span></td><td>@batch.TotalRecords</td><td>@batch.LinkedRecords</td><td>@batch.ErrorRecords</td><td><a asp-action="Details" asp-route-id="@batch.Id" class="btn btn-sm btn-outline-secondary">Details</a></td></tr> } @if (!Model.Any()) { <tr><td colspan="8" class="empty-state">No import previews yet.</td></tr> }</tbody></table></div></section>
