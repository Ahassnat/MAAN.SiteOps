@model MAAN.SiteOps.ViewModels.SourceRecordImportResultViewModel
@{ ViewData["Title"] = "Source Import Result"; }
<div class="page-header"><div><h2 class="page-title">Source Import Result</h2><p class="page-subtitle">ZITE Activity Report source ingestion completed.</p></div><a asp-action="Index" class="btn btn-outline-secondary">Data Imports</a></div>
<div class="kpi-grid"><div class="dashboard-card kpi-card"><div class="kpi-label">Source Records Read</div><div class="kpi-value">@Model.SourceRecordsRead</div></div><div class="dashboard-card kpi-card"><div class="kpi-label">Source Records Imported</div><div class="kpi-value">@Model.SourceRecordsImported</div></div><div class="dashboard-card kpi-card"><div class="kpi-label">Already Imported / Skipped</div><div class="kpi-value">@Model.AlreadyImportedOrSkipped</div></div><div class="dashboard-card kpi-card"><div class="kpi-label">Exact Source Duplicates</div><div class="kpi-value">@Model.ExactSourceDuplicates</div></div><div class="dashboard-card kpi-card"><div class="kpi-label">Ready for Normalization</div><div class="kpi-value">@Model.ReadyForNormalization</div></div><div class="dashboard-card kpi-card"><div class="kpi-label">Needs Review</div><div class="kpi-value">@Model.NeedsReview</div></div><div class="dashboard-card kpi-card"><div class="kpi-label">Errors</div><div class="kpi-value">@Model.Errors</div></div></div>
<div class="alert alert-info"><strong>Activities Created = @Model.ActivitiesCreated.</strong> Source records are stored for later normalization. No Activities, ProjectSites, project attributions, or indicator contributions were created.</div>
