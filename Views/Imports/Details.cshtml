@model MAAN.SiteOps.Models.ImportBatch
@{ ViewData["Title"] = "Import Preview Details"; }
<div class="page-header"><div><h2 class="page-title">Import Preview Details</h2><p class="page-subtitle">@Model.FileName</p></div><a asp-action="Index" class="btn btn-outline-secondary">Back to Imports</a></div><section class="section-card"><dl class="row mb-0"><dt class="col-sm-3">Source System</dt><dd class="col-sm-9">@Model.SourceSystem?.Code - @Model.SourceSystem?.Name</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd><dt class="col-sm-3">Started</dt><dd class="col-sm-9">@Model.StartedAt.ToLocalTime()</dd><dt class="col-sm-3">Completed</dt><dd class="col-sm-9">@Model.CompletedAt?.ToLocalTime()</dd><dt class="col-sm-3">Records Read</dt><dd class="col-sm-9">@Model.TotalRecords</dd><dt class="col-sm-3">Ready / Linked</dt><dd class="col-sm-9">@Model.LinkedRecords</dd><dt class="col-sm-3">Skipped</dt><dd class="col-sm-9">@Model.SkippedRecords</dd><dt class="col-sm-3">Warnings / Errors</dt><dd class="col-sm-9">@Model.ErrorRecords</dd></dl></section>
