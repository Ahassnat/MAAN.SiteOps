@model MAAN.SiteOps.Models.ImportBatch
@{ ViewData["Title"] = Model.Status == "Completed" ? "Completed Source Import" : "Import Preview Details"; }
<div class="page-header"><div><h2 class="page-title">@ViewData["Title"]</h2><p class="page-subtitle">@Model.FileName</p></div><a asp-action="Index" class="btn btn-outline-secondary">Back to Imports</a></div><section class="section-card"><dl class="row mb-0"><dt class="col-sm-3">Source System</dt><dd class="col-sm-9">@Model.SourceSystem?.Code - @Model.SourceSystem?.Name</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd><dt class="col-sm-3">Started</dt><dd class="col-sm-9">@Model.StartedAt.ToLocalTime()</dd><dt class="col-sm-3">Completed</dt><dd class="col-sm-9">@Model.CompletedAt?.ToLocalTime()</dd><dt class="col-sm-3">Records Read</dt><dd class="col-sm-9">@Model.TotalRecords</dd><dt class="col-sm-3">Ready / Imported source records</dt><dd class="col-sm-9">@Model.LinkedRecords</dd><dt class="col-sm-3">Skipped</dt><dd class="col-sm-9">@Model.SkippedRecords</dd><dt class="col-sm-3">Warnings / Errors</dt><dd class="col-sm-9">@Model.ErrorRecords</dd><dt class="col-sm-3">Processing Notes</dt><dd class="col-sm-9">@Model.Notes</dd></dl>@if (Model.Status == "Completed") { <div class="alert alert-info mt-3 mb-0">Source-only ingestion. ActivityId remains null; no operational Activities were created.</div> }</section>
